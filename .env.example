# Copy to .env (all modes) or .env.dev / .env.production (one mode).
# Read by pkg/env in the Go app; the process environment overrides both.
LIDZA_ADDR=127.0.0.1:3000
# LIDZA_TLS_DOMAINS=app.example.com   # production: serve HTTPS on 443 with Let's Encrypt, redirect 80; APP_URL and AUTH_COOKIE_SECURE follow
# LIDZA_TLS_EMAIL=ops@example.com     # ACME account contact
# SECURITY_CONTACT=security@example.com   # served as /.well-known/security.txt (RFC 9116); also an https:// or tel: URL, comma-separated
# AUTH_PROVIDERS=google,github        # sign-in providers served by auth.Mount; the client ids and secrets go in the credentials (lidza credentials set AUTH_GOOGLE_CLIENT_ID=... AUTH_GOOGLE_CLIENT_SECRET=...)

# lidza/db. lidza install writes this machine's address: the Postgres socket
# (/var/run/postgresql on Linux, /tmp on macOS) or 127.0.0.1:5432.
DATABASE_URL=postgres:///app_dev?host=/var/run/postgresql
DB_MAX_CONNS=10
# DB_MIGRATE=true   # apply db/migrations at start

# lidza/auth (needs lidza/db). AUTH_SECRET is generated on the first start and kept in the database.
# AUTH_ACCESS_TTL=15m        # app setting: lidza settings set AUTH_ACCESS_TTL=15m
# AUTH_REFRESH_TTL=720h      # app setting
# AUTH_COOKIE_SECURE=true   # behind TLS
# AUTH_LOGIN_RPS=1           # credential attempts per second per client (auth.Throttle)
# AUTH_LOGIN_BURST=5
# AUTH_SIGNIN_RPS=1          # sign-in attempts per second per client (auth.ThrottleSignIn); unset: AUTH_LOGIN_RPS
# AUTH_SIGNIN_BURST=5        # unset: AUTH_LOGIN_BURST
# AUTH_MIN_PASSWORD=10       # auth.ValidatePassword floor
# AUTH_TOKEN_TTL=1h          # verification and reset links
# AUTH_OWNER_CLAIM=true      # public deploys: the first admin claims with a one-time token (config/owner-claim/token), not by signing in first
# AUTH_PROVIDERS=google,github   # sign-in providers for auth.Mount; ids and secrets in the credentials
# AUTH_CONNECT=github             # external accounts users connect (auth.Connection); AUTH_CONNECT_GITHUB_CLIENT_ID and _CLIENT_SECRET in the credentials, _SCOPES optional

# lidza/jobs (needs lidza/db)
JOBS_WORKERS=4
JOBS_MAX_ATTEMPTS=5
# JOBS_DRAIN=1s   # at shutdown, running jobs may finish this long, then go back to pending

# lidza/mail (list lidza/db and lidza/jobs before it for the outbox and background delivery) (app settings: set them here, or keep them in the app with the admin pages or lidza settings set NAME=value)
# MAIL_PROVIDER=log        # log | outbox | smtp | mailgun | sendgrid | postmark | resend
# MAIL_FROM="App <app@example.com>"   # development default: dev@localhost
# APP_URL=https://app.example.com   # where links in emails point; development default: http:// plus LIDZA_ADDR
# MAIL_API_KEY=            # mailgun, sendgrid, postmark, resend
# MAIL_DOMAIN=example.com  # mailgun
# MAIL_BASE_URL=https://api.eu.mailgun.net   # a provider's regional API
# MAIL_SMTP_URL=smtp://user:pass@smtp.example.com:587   # or smtps://...:465
# MAIL_MAX_ATTEMPTS=5      # delivery retries through the jobs pack

# lidza/cache
CACHE_URL=redis://127.0.0.1:6379
# CACHE_URL=memory   # bounded in-process cache for one node or tests

# lidza/realtime
# REALTIME_BUS_URL=redis://127.0.0.1:6379   # required with more than one node
REALTIME_MAX_CONNS=10000

# lidza/storage (app settings: set them here, or keep them in the app with the admin pages or lidza settings set NAME=value)
# STORAGE_PROVIDER=local   # local | s3 | r2 | spaces | b2 | gcs | minio
# STORAGE_DIR=storage       # local: where the files go
# STORAGE_BUCKET=           # s3
# STORAGE_ENDPOINT=https://s3.amazonaws.com   # or https://<account>.r2.cloudflarestorage.com, http://127.0.0.1:9000 (MinIO)
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=       # keep both keys in the app: lidza settings set STORAGE_ACCESS_KEY=... STORAGE_SECRET_KEY=...
# STORAGE_PUBLIC_URL=       # a CDN or public bucket; URL(key) returns it plus the key
# STORAGE_PREFIX=           # a folder every key goes under, for a bucket several apps share
# STORAGE_MAX_SIZE=104857600   # one Put, bytes

# Zing external network OAuth (app settings, also supported through sealed settings).
APP_URL=http://127.0.0.1:3000
# Production: use your public HTTPS origin. Bluesky reads /oauth-client-metadata.json.
# Mastodon and Threads callback: <APP_URL>/api/v1/connections/callback
# Bluesky callback: <APP_URL>/api/v1/connections/bluesky/callback
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# Docker Compose only; use a strong password in the untracked .env.production.
POSTGRES_PASSWORD=
