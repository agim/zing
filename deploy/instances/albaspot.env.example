# This deployment profile is for the owner's private instance, not a repository-wide domain requirement.
# Set these ordinary runtime values in lidza-deploy.albaspot.com for agim/zing, branch main.
APP_URL=https://zing.albaspot.com
AUTH_OWNER_CLAIM=true
AUTH_COOKIE_SECURE=true
ZING_ACCESS_MODE=private
ZING_REQUIRE_SETUP=true
DB_MIGRATE=true
# Optional initial allowlist; can be managed in the encrypted database through /setup.
# ZING_ALLOWED_EMAILS=you@example.com
# DATABASE_URL and LIDZA_MASTER_KEY are protected bootstrap infrastructure.
# Never commit credential values. Configure SMTP, object storage and Threads in the installation UI.
